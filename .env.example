POSTGRES_USER=memory
POSTGRES_PASSWORD=change-me
POSTGRES_DB=memory
DATABASE_URL=postgresql://memory:change-me@mcp-memory-db:5432/memory
# Optional with Ollama embeddings; when set, also enables AI metadata extraction.
OPENAI_API_KEY=sk-your-key-here
MCP_API_KEY=change-me

# Optional: duplicate detection threshold (0.0-1.0, default 0.95; 0.975 for nomic-embed-text)
# DUPLICATE_THRESHOLD=0.95

# Optional: embedding provider. Defaults to OpenAI (any OpenAI-compatible API);
# "ollama" uses Ollama's native /api/embed. Changing the model invalidates
# existing embeddings; see README "Switching an existing store".
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=        # defaults to OPENAI_API_KEY; never sent to Ollama
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DOC_PREFIX=     # e.g. "search_document: " for nomic-embed-text
# EMBEDDING_QUERY_PREFIX=   # e.g. "search_query: "
# EMBEDDING_NUM_THREAD=0    # Ollama only; 0 = Ollama's default
# EMBEDDING_MAX_TOKENS=2048 # Ollama only; inputs reaching this are flagged truncated
# FIND_RELATED_THRESHOLD=0.85  # 0.90 for nomic-embed-text
