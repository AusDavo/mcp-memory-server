POSTGRES_USER=memory
POSTGRES_PASSWORD=change-me
POSTGRES_DB=memory
DATABASE_URL=postgresql://memory:change-me@mcp-memory-db:5432/memory
OPENAI_API_KEY=sk-your-key-here
MCP_API_KEY=change-me

# Optional: duplicate detection threshold (0.0-1.0, default 0.95)
# DUPLICATE_THRESHOLD=0.95

# Optional: custom embedding provider (any OpenAI-compatible API)
# Defaults to OpenAI. Changing provider/dimensions invalidates existing embeddings.
# EMBEDDING_API_KEY=        # defaults to OPENAI_API_KEY
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_MODEL=text-embedding-3-small
